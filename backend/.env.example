# Keep model artifacts local; point this at the directory created by training.
CARDIOVISION_ARTIFACT_DIR=./artifacts
# Comma-separated exact browser origins when a direct cross-origin frontend is used.
CORS_ORIGINS=http://localhost:3000
# Optional additional preview/deployment origin pattern. Never use an unrestricted wildcard in production.
CORS_ORIGIN_REGEX=^https://.*\.(e2b\.app|vercel\.app)$
LOG_LEVEL=INFO
