# Browser requests use the same-origin /backend rewrite by default.
# In development, the Next.js server proxies /backend/* to BACKEND_URL.
BACKEND_URL=http://127.0.0.1:8000

# Optional direct browser-facing API origin (must have matching CORS on the backend).
# Leave unset to use the relative /backend path and avoid browser localhost calls.
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com
